---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categorias } from "../data/categorias";
import { getCollection } from "astro:content";

const proyectos = await getCollection("proyectos");
const conteoPorCategoria = Object.fromEntries(
  categorias.map((c) => [c.slug, proyectos.filter((p) => p.data.categoria === c.slug).length]),
);
---

<BaseLayout
  title="Inicio"
  description="Guías paso a paso para entender, dimensionar y montar circuitos electrónicos, organizadas por tipo de proyecto."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Guías de montaje electrónico</p>
        <h1>Entiende, construye y aprende sobre el maravilloso mundo de la electronica.</h1>
        <p class="lead">
          Foro Electric es un catálogo de proyectos electrónicos explicados de punta a punta:
          por qué funcionan, qué necesitas para construirlos y cómo saber si quedaron bien
          montados. Pensado para estudiantes, autodidactas y cualquiera con curiosidad por el
          mundo de la electronica.
        </p>
        <div class="acciones">
          <a class="btn btn-primary" href="#categorias">Ver proyectos</a>
          <a class="btn btn-ghost" href="/equipo">Quiénes somos</a>
        </div>
      </div>
      <ul class="promesas">
        <li>
          <span class="num">01</span>
          <div>
            <p class="t">Dificultades dimensionadas en diversos aspectos, para saber a que te enfrentas</p>
            <p class="d">Cada guía se puntúa con la misma rúbrica de seis aspectos, así que los niveles significa lo mismo en cualquier proyecto.</p>
          </div>
        </li>
        <li>
          <span class="num">02</span>
          <div>
            <p class="t">Costos con fecha</p>
            <p class="d">Te entregamos un rango de precios en COP para el dimensionamiento del proyecto, junto
            con links de apoyo para facilitar la construcción de los proyectos.</p>
          </div>
        </li>
        <li>
          <span class="num">03</span>
          <div>
            <p class="t">Diagnóstico incluido</p>
            <p class="d">Además de montar, cada guía documenta las fallas más comunes y cómo descartarlas cuando algo no funciona como quisieramos.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section id="categorias" class="categorias">
    <div class="container">
      <p class="eyebrow">Clasificación de proyectos</p>
      <h2>Elige que proyectos pueden ser mas afínes a tus objetivos</h2>
      <p class="sub">
        Cada proyecto vive en una categoría según su función. Dentro de cada una puedes filtrar
        además por dificultad, costo, tiempo y los conceptos que usa.
      </p>

      <div class="grilla">
        {
          categorias.map((c) => (
            <a class="tarjeta" href={`/categoria/${c.slug}`}>
              <span class="cont">{conteoPorCategoria[c.slug] ?? 0} proyectos</span>
              <h3>{c.nombre}</h3>
              <p>{c.descripcion}</p>
              <span class="ir" aria-hidden="true">Ver proyectos →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="franjas">
    <div class="container franjas-grid">
      <div class="franja">
        <p class="eyebrow">Sostenimiento</p>
        <h2>Donaciones voluntarias</h2>
        <p>
          El sitio y las guías se mantienen con tiempo de colaboradores y algo de presupuesto
          para componentes de prueba. Si te sirvió una guía, puedes apoyar el proyecto.
        </p>
        <a class="btn btn-ghost" href="/donaciones">Ver cómo apoyar</a>
      </div>
      <div class="franja">
        <p class="eyebrow">Quiénes lo hacemos</p>
        <h2>Un proyecto de colaboradores activos</h2>
        <p>
          Cada guía la arma, fotografía y prueba una persona real antes de publicarse. Conoce
          quién está detrás del sitio y de cada proyecto.
        </p>
        <a class="btn btn-ghost" href="/equipo">Conocer al equipo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 4rem 3rem;
    border-bottom: 1px solid var(--rule);
  }
  .hero-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
    }
  }
  .hero h1 {
    font-size: clamp(2rem, 4.2vw, 3rem);
    line-height: 1.08;
    margin-top: 0.75rem;
    max-width: 18ch;
  }
  .lead {
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--ink-2);
    max-width: 52ch;
    margin-top: 1.1rem;
    line-height: 1.6;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .promesas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .promesas li {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.85rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
  }
  .promesas li:first-child {
    padding-top: 0;
    border-top: none;
  }
  .promesas .num {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--copper);
    padding-top: 0.15rem;
  }
  .promesas .t {
    font-family: var(--sans);
    font-weight: 650;
    font-size: 0.95rem;
    margin-bottom: 0.3rem;
  }
  .promesas .d {
    font-size: 0.86rem;
    color: var(--ink-2);
    line-height: 1.55;
  }

  .categorias {
    padding-block: 4rem;
  }
  .categorias h2 {
    font-size: 1.9rem;
    margin-top: 0.6rem;
  }
  .categorias .sub {
    font-family: var(--serif);
    color: var(--ink-2);
    max-width: 58ch;
    margin-top: 0.9rem;
  }
  .grilla {
    display: grid;
    gap: 1rem;
    margin-top: 2.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .grilla {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .grilla {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--accent);
    padding: 1.4rem 1.5rem 1.6rem;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .tarjeta:hover {
    box-shadow: var(--shadow);
  }
  .tarjeta .cont {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .tarjeta h3 {
    font-family: var(--sans);
    font-size: 1.2rem;
  }
  .tarjeta p {
    font-family: var(--serif);
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .tarjeta .ir {
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.84rem;
    font-weight: 650;
    color: var(--accent);
  }

  .franjas {
    padding-block: 1rem 4rem;
  }
  .franjas-grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 780px) {
    .franjas-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .franja {
    background: var(--surface-2);
    border: 1px solid var(--rule);
    padding: 2rem 2.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .franja h2 {
    font-size: 1.35rem;
  }
  .franja p:not(.eyebrow) {
    font-family: var(--serif);
    color: var(--ink-2);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }
</style>
