---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Carousel from "../../components/Carousel.astro";
import DifficultyMeter from "../../components/DifficultyMeter.astro";
import { calcularDificultad, EJE_LABELS } from "../../utils/dificultad";
import {
  calcularCosto,
  formatoCOP,
  ETIQUETA_BANDA,
  type ComponenteCatalogo,
} from "../../utils/costos";
import { categoriaPorSlug } from "../../data/categorias";
import { textoAdvertencia } from "../../data/advertencias";

export async function getStaticPaths() {
  const proyectos = await getCollection("proyectos");
  return proyectos.map((p) => ({ params: { slug: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props;
const p = proyecto.data;
const { Content } = await render(proyecto);

const dificultad = calcularDificultad(p.dificultad);
const categoria = categoriaPorSlug(p.categoria)!;

const componentesEntradas = await getCollection("componentes");
const catalogo = new Map<string, ComponenteCatalogo>(
  componentesEntradas.map((c) => [c.id, c.data as ComponenteCatalogo]),
);
const costo = calcularCosto(p.materiales, catalogo);

const conceptosEntradas = await getCollection("conceptos");
const conceptosMap = new Map(conceptosEntradas.map((c) => [c.id, c.data]));

const ESTADO_LABEL: Record<string, string> = {
  borrador: "Borrador",
  revision: "En revisión",
  publicado: "Probado",
  obsoleto: "Obsoleto",
};

const fechaLarga = new Intl.DateTimeFormat("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(p.actualizado);

const TIPO_APOYO_LABEL: Record<string, string> = {
  enlace: "Enlace",
  pdf: "PDF",
  video: "Video",
  datasheet: "Datasheet",
};

const URL_REPORTAR_ERROR = "https://github.com/xItach/Proyecto_foroelectric/issues/new";

const secciones = [
  ["ficha", "Ficha técnica"],
  ["fotos", "Fotos"],
  ["introduccion", "Introducción"],
  ["conceptos", "Conceptos previos"],
  ["materiales", "Materiales"],
  ["diagramas", "Diagramas"],
  ["montaje", "Montaje"],
  ["resultados", "Resultados"],
  ["fallas", "Fallas comunes"],
  ["apoyo", "Material de apoyo"],
  ["notas", "Notas"],
  ["reportar", "Reportar un error"],
] as const;
---

<BaseLayout title={p.titulo} description={p.proposito}>
  <div class="shell">
    <header class="cabecera">
      <div class="container">
        <p class="eyebrow">
          <a href={`/categoria/${p.categoria}`}>{categoria.nombre}</a> / {p.titulo}
        </p>
        <h1>{p.titulo}</h1>
        <p class="proposito">{p.proposito}</p>
      </div>
    </header>

    <div class="container cuerpo">
      <nav class="rail" aria-label="Índice de la guía">
        <p>En esta guía</p>
        <ol>
          {secciones.map(([id, etiqueta]) => <li><a href={`#${id}`}>{etiqueta}</a></li>)}
        </ol>
      </nav>

      <main class="flow">
        <section id="ficha">
          <h2>Ficha técnica</h2>

          {
            (p.seguridad.red_electrica || p.seguridad.advertencias.length > 0) && (
              <div class="aviso-riesgo">
                <p class="titulo-aviso">⚠ Antes de empezar</p>
                <ul>
                  {p.seguridad.red_electrica && (
                    <li>{textoAdvertencia("tension-de-red")}</li>
                  )}
                  {p.seguridad.advertencias.map((a) => <li>{textoAdvertencia(a)}</li>)}
                </ul>
              </div>
            )
          }

          <div class="specs">
            <div class="spec">
              <span class="lbl">Dificultad</span>
              <DifficultyMeter nivel={dificultad.nivel} etiqueta={dificultad.etiqueta} />
              <ul class="ejes">
                {Object.entries(p.dificultad).map(([eje, valor]) => (
                  <li>{EJE_LABELS[eje as keyof typeof EJE_LABELS]}: <b>{valor}/2</b></li>
                ))}
              </ul>
            </div>
            <div class="spec">
              <span class="lbl">Tiempo de montaje</span>
              <span class="val">{p.tiempo.horas_min}–{p.tiempo.horas_max} h en {p.tiempo.sesiones} sesiones</span>
              <span class="nota">Para alguien que {p.tiempo.perfil}. No incluye compra ni envío de materiales.</span>
            </div>
            <div class="spec">
              <span class="lbl">Costo aproximado</span>
              <span class="val">{ETIQUETA_BANDA[costo.banda]} · {formatoCOP(costo.totalMin)}–{formatoCOP(costo.totalMax)} COP</span>
              <span class="nota">Ver detalle y fecha de verificación en <a href="#materiales">Materiales</a>.</span>
            </div>
            <div class="spec">
              <span class="lbl">Estado</span>
              <span class={`val estado-${p.estado}`}>{ESTADO_LABEL[p.estado]}</span>
              <span class="nota">Actualizado el {fechaLarga}.</span>
            </div>
          </div>

          {
            p.etiquetas.length > 0 && (
              <div class="tags">{p.etiquetas.map((t) => <span class="tag">{t}</span>)}</div>
            )
          }
        </section>

        <section id="fotos">
          <h2>Fotos del montaje</h2>
          <Carousel imagenes={p.imagenes} />
        </section>

        <section id="introduccion">
          <h2>Introducción</h2>
          <div class="prosa">
            <Content />
          </div>
        </section>

        <section id="conceptos">
          <h2>Conceptos previos</h2>
          {
            p.conceptos.length > 0 ? (
              <ul class="conceptos">
                {p.conceptos.map((c) => {
                  const ficha = conceptosMap.get(c.slug);
                  return (
                    <li>
                      <a href={`/conceptos/${c.slug}`}>{ficha?.nombre ?? c.slug}</a>
                      <p>{c.nota}</p>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p class="vacio">Este proyecto no requiere conceptos previos específicos.</p>
            )
          }
        </section>

        <section id="materiales">
          <h2>Materiales</h2>

          {
            costo.faltantes.length > 0 && (
              <p class="advertencia-datos">
                Referencias sin precio en el catálogo: {costo.faltantes.join(", ")}.
              </p>
            )
          }
          {
            costo.precioDesactualizado && (
              <p class="advertencia-datos">
                Algunos precios llevan más de 6 meses sin verificarse — pueden estar desactualizados.
              </p>
            )
          }

          <div class="tw">
            <table>
              <thead>
                <tr><th>Componente</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th></tr>
              </thead>
              <tbody>
                {
                  costo.lineas.map((l) => (
                    <tr>
                      <td>
                        {l.componente?.nombre ?? l.ref}
                        {l.nota && <span class="nota-linea"> — {l.nota}</span>}
                      </td>
                      <td>{l.cantidad}</td>
                      <td>{l.componente ? formatoCOP(l.componente.precio) : "—"}</td>
                      <td>{l.componente ? formatoCOP(l.subtotal) : "—"}</td>
                    </tr>
                  ))
                }
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="3">Total aproximado ({ETIQUETA_BANDA[costo.banda].toLowerCase()})</td>
                  <td>{formatoCOP(costo.totalMin)}–{formatoCOP(costo.totalMax)}</td>
                </tr>
              </tfoot>
            </table>
          </div>

          <h3>Herramientas necesarias</h3>
          <p class="nota-herramientas">Se compran una vez, no entran al costo del proyecto.</p>
          {
            p.herramientas.length > 0 ? (
              <ul class="herramientas">{p.herramientas.map((h) => <li>{h}</li>)}</ul>
            ) : (
              <p class="vacio">No requiere herramientas además de las básicas de soldadura.</p>
            )
          }
        </section>

        <section id="diagramas">
          <h2>Diagramas eléctricos</h2>
          {
            p.diagramas.length > 0 ? (
              <div class="diagramas">
                {p.diagramas.map((d) => (
                  <figure class="diagrama">
                    {d.src ? (
                      <img src={d.src} alt={d.alt} loading="lazy" />
                    ) : (
                      <div class="placeholder-diagrama" role="img" aria-label={d.alt}>
                        <span>{d.alt}</span>
                      </div>
                    )}
                    <figcaption>{d.titulo}</figcaption>
                  </figure>
                ))}
              </div>
            ) : (
              <p class="vacio">Diagrama pendiente de adjuntar.</p>
            )
          }
        </section>

        <section id="montaje">
          <h2>Procedimiento de montaje</h2>
          {
            p.pasos.length > 0 ? (
              <ol class="pasos">
                {p.pasos.map((paso, i) => (
                  <li>
                    <span class="idx">{String(i + 1).padStart(2, "0")}</span>
                    <div>
                      <p class="titulo-paso">{paso.titulo}</p>
                      <p class="contenido-paso">{paso.contenido}</p>
                      {paso.verificacion && (
                        <p class="verificacion">✓ Antes de seguir: {paso.verificacion}</p>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="vacio">Procedimiento paso a paso pendiente de documentar.</p>
            )
          }
        </section>

        <section id="resultados">
          <h2>Resultados esperados</h2>
          {
            p.resultados.length > 0 ? (
              <div class="tw">
                <table>
                  <thead><tr><th>Parámetro</th><th>Valor esperado</th></tr></thead>
                  <tbody>
                    {p.resultados.map((r) => (
                      <tr><td>{r.parametro}</td><td>{r.esperado}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="vacio">Resultados medibles pendientes de documentar.</p>
            )
          }
        </section>

        <section id="fallas">
          <h2>Fallas comunes y diagnóstico</h2>
          {
            p.fallas.length > 0 ? (
              <dl class="fallas">
                {p.fallas.map((f) => (
                  <div class="falla">
                    <dt>{f.sintoma}</dt>
                    <dd>
                      <ul>{f.causas.map((c) => <li>{c}</li>)}</ul>
                    </dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="vacio">
                Todavía no hay fallas registradas para este proyecto — se documentan a medida que
                aparecen.
              </p>
            )
          }
        </section>

        <section id="apoyo">
          <h2>Material de apoyo</h2>
          {
            p.apoyo.length > 0 ? (
              <ul class="apoyo">
                {p.apoyo.map((a) => (
                  <li>
                    <a href={a.url}>{a.titulo}</a>
                    <span class="tag">{TIPO_APOYO_LABEL[a.tipo]}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="vacio">Sin material de apoyo adicional por ahora.</p>
            )
          }
        </section>

        <section id="notas">
          <h2>Notas del colaborador</h2>
          {
            p.notas_colaborador ? (
              <p class="notas">{p.notas_colaborador}</p>
            ) : (
              <p class="vacio">Sin notas adicionales del colaborador.</p>
            )
          }
          <dl class="creditos">
            <div>
              <dt>Probado por</dt>
              <dd>{p.probado_por.length > 0 ? p.probado_por.join(", ") : "Aún no probado físicamente"}</dd>
            </div>
            <div>
              <dt>Licencia</dt>
              <dd>{p.licencia}</dd>
            </div>
            <div>
              <dt>Última actualización</dt>
              <dd>{fechaLarga}</dd>
            </div>
          </dl>
        </section>

        <section id="reportar">
          <h2>¿Encontraste un error?</h2>
          <div class="cta-reportar">
            <p>
              Todavía no hay comentarios abiertos en el sitio. Si algo en esta guía está mal, es
              ambiguo o dejó de funcionar, repórtalo directamente — es lo que mantiene la guía
              confiable para el siguiente lector.
            </p>
            <a class="btn btn-primary" href={URL_REPORTAR_ERROR}>Reportar un error</a>
          </div>
        </section>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .cabecera {
    padding-block: 2.5rem 1.5rem;
    border-bottom: 1px solid var(--rule);
    background: var(--surface-2);
  }
  .cabecera .eyebrow a {
    color: var(--ink-3);
  }
  .cabecera h1 {
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
    margin-top: 0.5rem;
    max-width: 32ch;
  }
  .proposito {
    font-family: var(--serif);
    color: var(--ink-2);
    font-size: 1.05rem;
    max-width: 60ch;
    margin-top: 0.7rem;
  }

  .cuerpo {
    display: grid;
    gap: 3rem;
    padding-block: 3rem 5rem;
  }
  @media (min-width: 1000px) {
    .cuerpo {
      grid-template-columns: 13rem minmax(0, 1fr);
      align-items: start;
    }
  }

  .rail {
    display: none;
  }
  @media (min-width: 1000px) {
    .rail {
      display: block;
      position: sticky;
      top: 5.5rem;
      font-family: var(--mono);
      font-size: 0.74rem;
      line-height: 1.5;
    }
  }
  .rail p {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-3);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0.75rem;
  }
  .rail ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .rail a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .rail a:hover {
    color: var(--accent);
  }

  .flow {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3.25rem;
  }
  .flow section {
    scroll-margin-top: 5.5rem;
  }
  .flow h2 {
    font-size: 1.5rem;
    padding-top: 0.9rem;
    border-top: 2px solid var(--ink);
    margin-bottom: 1rem;
  }
  .flow h3 {
    font-size: 1rem;
    margin: 1.5rem 0 0.5rem;
  }
  .vacio {
    font-family: var(--serif);
    color: var(--ink-3);
    font-style: italic;
  }

  .aviso-riesgo {
    background: var(--crit-bg);
    border: 1px solid var(--crit);
    padding: 1rem 1.2rem;
    margin-bottom: 1.5rem;
  }
  .titulo-aviso {
    font-family: var(--sans);
    font-weight: 700;
    color: var(--crit);
    margin-bottom: 0.4rem;
  }
  .aviso-riesgo ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink);
    font-size: 0.92rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .specs {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .specs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .spec {
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .spec .lbl {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .spec .val {
    font-family: var(--sans);
    font-weight: 650;
    font-size: 0.95rem;
  }
  .spec .nota {
    font-family: var(--serif);
    font-size: 0.82rem;
    color: var(--ink-2);
  }
  .spec .estado-publicado { color: var(--ok); }
  .spec .estado-borrador, .spec .estado-revision { color: var(--warn); }
  .spec .estado-obsoleto { color: var(--crit); }
  .ejes {
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-2);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1.1rem;
  }

  .prosa {
    font-family: var(--serif);
    font-size: 1.02rem;
    line-height: 1.7;
    max-width: 68ch;
  }
  .prosa :global(p + p) {
    margin-top: 1rem;
  }

  .conceptos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .conceptos a {
    font-family: var(--sans);
    font-weight: 650;
    text-decoration: none;
  }
  .conceptos p {
    font-family: var(--serif);
    color: var(--ink-2);
    font-size: 0.92rem;
    margin-top: 0.25rem;
    max-width: 60ch;
  }

  .advertencia-datos {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--warn);
    background: var(--warn-bg);
    border: 1px solid var(--warn);
    padding: 0.6rem 0.85rem;
    margin-bottom: 1rem;
  }
  .tw {
    overflow-x: auto;
    border: 1px solid var(--rule);
    background: var(--surface);
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 32rem;
    font-size: 0.9rem;
  }
  thead th {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-align: left;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--rule-strong);
    background: var(--surface-2);
  }
  tbody td {
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
    vertical-align: top;
  }
  tbody td:first-child {
    color: var(--ink);
    font-weight: 600;
    font-family: var(--sans);
    font-size: 0.87rem;
  }
  .nota-linea {
    font-weight: 400;
    color: var(--ink-3);
    font-family: var(--serif);
  }
  tfoot td {
    padding: 0.7rem 0.9rem;
    font-family: var(--sans);
    font-weight: 700;
    color: var(--ink);
    border-top: 2px solid var(--ink);
  }
  .nota-herramientas {
    font-family: var(--serif);
    font-size: 0.85rem;
    color: var(--ink-3);
    margin-bottom: 0.5rem;
  }
  .herramientas {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-2);
    font-size: 0.92rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .diagramas {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .diagramas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .diagrama img {
    width: 100%;
    border: 1px solid var(--rule);
  }
  .placeholder-diagrama {
    aspect-ratio: 4 / 3;
    border: 1px dashed var(--rule-strong);
    background: repeating-linear-gradient(135deg, var(--surface-2) 0 8px, transparent 8px 16px),
      var(--surface);
    display: flex;
    align-items: flex-end;
    padding: 0.7rem;
  }
  .placeholder-diagrama span {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-3);
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: 0.25rem 0.5rem;
  }
  .diagrama figcaption {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--ink-3);
    margin-top: 0.5rem;
  }

  .pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    counter-reset: paso;
  }
  .pasos li {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.9rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: 0.9rem 1.1rem;
  }
  .pasos .idx {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--copper);
    padding-top: 0.15rem;
  }
  .titulo-paso {
    font-family: var(--sans);
    font-weight: 650;
    font-size: 0.95rem;
  }
  .contenido-paso {
    font-family: var(--serif);
    color: var(--ink-2);
    font-size: 0.92rem;
    margin-top: 0.3rem;
    line-height: 1.55;
  }
  .verificacion {
    font-family: var(--sans);
    font-size: 0.84rem;
    color: var(--ok);
    background: var(--ok-bg);
    border: 1px solid var(--ok);
    padding: 0.4rem 0.6rem;
    margin-top: 0.6rem;
    display: inline-block;
  }

  .fallas {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .falla {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--warn);
    padding: 1rem 1.2rem;
  }
  .falla dt {
    font-family: var(--sans);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .falla dd {
    margin: 0;
  }
  .falla ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-2);
    font-size: 0.92rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .apoyo {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .apoyo li {
